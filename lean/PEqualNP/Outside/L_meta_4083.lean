lemma same_key (C : Circuit) (s : ℕ) (A B : Finset ℕ)
    (hC : ∀ x, C.eval (input x) = graph x)
    (hA : ∀ j : Fin 10, j.val ∈ A ↔ j ∈ mask s) (h0 : 10 ∈ A ↔ (0 : Fin 10) ∈ mask s)
    (hedge : ∀ (j : Fin C.size) i, i ∈ (C.gates.get j).inputs →
      (11+j.val ∈ A → i ∈ A) ∧ (11+j.val ∉ A → i ∈ A → i ∈ B))
    (hout : C.output ∈ A → C.output ∈ B)
    (t u : ℕ) (he : ∀ i ∈ B, val C (base s t) i = val C (base s u) i) :
    key s t = key s u := by
  have hin (v : ℕ) (k : Fin 11) : ∀ i ∈ A, val C (probe s v k) i = val C (base s v) i := by
    apply in_agree C (mask s) A B hA h0 hedge
    intro j hj
    have hm := (mask_mem s j).mp hj
    simp [probe, base, hm]
  have hb (k : Fin 11) : ∀ i ∈ A, i ∈ B → val C (probe s t k) i = val C (probe s u k) i := by
    intro i ha hb
    exact (hin t k i ha).trans ((he i hb).trans (hin u k i ha).symm)
  have ho (k : Fin 11) : val C (probe s t k) C.output = val C (probe s u k) C.output := by
    by_cases ha : C.output ∈ A
    · exact hb k C.output ha (hout ha)
    · apply out_agree C (mask s) A B hA h0 hedge _ _ _ (hb k) _ ha
      intro j hj
      have hm : s.testBit j.val = false := by
        cases he : s.testBit j.val
        · rfl
        · exact False.elim (hj ((mask_mem s j).mpr he))
      simp [probe, hm]
  unfold key
  have eq : (fun k : Fin 11 => graph (probe s t k)) = (fun k : Fin 11 => graph (probe s u k)) := by
    funext k
    rw [← hC, ← hC]
    exact ho k
  rw [eq]

lemma main (C : Circuit) (S : Finset (Fin 10)) (A B : Finset ℕ)
    (hC : ∀ x, C.eval (input x) = graph x)
    (hA : ∀ j : Fin 10, j.val ∈ A ↔ j ∈ S) (h0 : 10 ∈ A ↔ (0 : Fin 10) ∈ S)
    (hedge : ∀ (j : Fin C.size) i, i ∈ (C.gates.get j).inputs →
      (11+j.val ∈ A → i ∈ A) ∧ (11+j.val ∉ A → i ∈ A → i ∈ B))
    (hout : C.output ∈ A → C.output ∈ B) :
    bound S.card ≤ (Finset.univ.image (fun x : Fin 10 → Bool => fun i : ↥B => val C x i)).card := by
  classical
  obtain ⟨s,hs,rfl⟩ := mask_surj S
  obtain ⟨hlen,hnd⟩ := all_cert s hs
  let f (j : Fin (rows s).length) : ↥B → Bool := fun i => val C (base s ((rows s).get j)) i
  have hf : Function.Injective f := by
    intro j k he
    have hk := same_key C s A B hC hA h0 hedge hout ((rows s).get j) ((rows s).get k)
      (fun i hi => congrFun he ⟨i,hi⟩)
    have hget : ((rows s).map (key s)).get ⟨j.val,by simpa using j.isLt⟩ =
        ((rows s).map (key s)).get ⟨k.val,by simpa using k.isLt⟩ := by simpa using hk
    have hidx := (List.nodup_iff_injective_get.mp hnd) hget
    exact Fin.ext (congrArg (fun i : Fin ((rows s).map (key s)).length => i.val) hidx)
  have hsub : Finset.univ.image f ⊆ Finset.univ.image (fun x : Fin 10 → Bool => fun i : ↥B => val C x i) := by
    intro a ha
    obtain ⟨j,_,rfl⟩ := Finset.mem_image.mp ha
    exact Finset.mem_image.mpr ⟨base s ((rows s).get j),Finset.mem_univ _,rfl⟩
  have hc := Finset.card_le_card hsub
  rw [Finset.card_image_of_injective _ hf, Finset.card_univ, Fintype.card_fin, hlen] at hc
  exact hc


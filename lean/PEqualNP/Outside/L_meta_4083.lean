    simp only [graph, Bool.or_eq_true, Bool.and_eq_true] at h
    rcases h with ((((((((((((((⟨ha,hb⟩ | ⟨ha,hb⟩) | ⟨ha,hb⟩) | ⟨ha,hb⟩) | ⟨ha,hb⟩) | ⟨ha,hb⟩) | ⟨ha,hb⟩) | ⟨ha,hb⟩) | ⟨ha,hb⟩) | ⟨ha,hb⟩) | ⟨ha,hb⟩) | ⟨ha,hb⟩) | ⟨ha,hb⟩) | ⟨ha,hb⟩) | ⟨ha,hb⟩)
    · exact ⟨0,1,ha,hb,by decide⟩
    · exact ⟨1,2,ha,hb,by decide⟩
    · exact ⟨2,3,ha,hb,by decide⟩
    · exact ⟨3,4,ha,hb,by decide⟩
    · exact ⟨4,0,ha,hb,by decide⟩
    · exact ⟨0,5,ha,hb,by decide⟩
    · exact ⟨1,6,ha,hb,by decide⟩
    · exact ⟨2,7,ha,hb,by decide⟩
    · exact ⟨3,8,ha,hb,by decide⟩
    · exact ⟨4,9,ha,hb,by decide⟩
    · exact ⟨5,7,ha,hb,by decide⟩
    · exact ⟨7,9,ha,hb,by decide⟩
    · exact ⟨9,6,ha,hb,by decide⟩

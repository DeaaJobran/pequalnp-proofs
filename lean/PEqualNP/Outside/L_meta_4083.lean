def step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]
def run (gs : List Gate) (w : List Bool) : List Bool := gs.foldl step w
lemma run_pre (gs : List Gate) (w : List Bool) (i : ℕ) (hi : i < w.length) :
    (run gs w).getD i false = w.getD i false := by
  induction gs generalizing w with
  | nil => rfl
  | cons g gs ih =>
    change (run gs (step w g)).getD i false = _
    rw [ih _ (by simp [step]; omega)]
    simp only [step, List.getD_eq_getElem?_getD, List.getElem?_append_left hi]

lemma run_agree (gs : List Gate) (w v : List Bool) (P Q : ℕ → Prop)
    (hlen : w.length = v.length)
    (hin : ∀ i, P i → w.getD i false = v.getD i false)
    (hedge : ∀ (j : Fin gs.length) i, i ∈ (gs.get j).inputs →
      P (w.length+j.val) → P i ∨ Q i)
    (hQ : ∀ i, Q i → (run gs w).getD i false = (run gs v).getD i false) :
    ∀ i, P i → (run gs w).getD i false = (run gs v).getD i false := by
  induction gs generalizing w v with
  | nil => exact hin
  | cons g gs ih =>
    apply ih (step w g) (step v g)
    · simp [step, hlen]
    · intro i hp
      by_cases hi : i < w.length
      · have hi' : i < v.length := by omega
        simpa only [step, List.getD_eq_getElem?_getD, List.getElem?_append_left hi,
          List.getElem?_append_left hi'] using hin i hp
      · by_cases he : i = w.length
        · subst i
          have hmap : (g.inputs.map fun i => w.getD i false) =
              (g.inputs.map fun i => v.getD i false) := by
            apply List.map_congr_left
            intro a ha
            rcases hedge ⟨0,by simp⟩ a ha (by simpa using hp) with hP | hq
            · exact hin a hP
            · by_cases hal : a < w.length
              · have hal' : a < v.length := by omega
                rw [← run_pre (g::gs) w a hal, ← run_pre (g::gs) v a hal']
                exact hQ a hq
              · rw [List.getD_eq_default _ _ (by omega), List.getD_eq_default _ _ (by omega)]
          simp only [List.getD_eq_getElem?_getD] at hmap
          simp [step, List.getD_eq_getElem?_getD, hlen, hmap]
        · have h1 : (step w g).length ≤ i := by simp [step]; omega
          have h2 : (step v g).length ≤ i := by simp [step]; omega
          rw [List.getD_eq_default _ _ h1, List.getD_eq_default _ _ h2]
    · intro j i hi hp
      have h := hedge ⟨j.val+1,by simp⟩ i hi
      apply h
      simpa [step, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hp
    · exact hQ


lemma input_len (x : Fin 10 → Bool) : (input x).length = 11 := by simp [input]
lemma input_agree (S : Finset (Fin 10)) (A : Finset ℕ)
    (hA : ∀ j : Fin 10, j.val ∈ A ↔ j ∈ S) (h0 : 10 ∈ A ↔ (0 : Fin 10) ∈ S)
    (b : Bool) (x y : Fin 10 → Bool)
    (h : ∀ j : Fin 10, (decide (j ∈ S)) = b → x j = y j) :
    ∀ i : ℕ, (decide (i ∈ A)) = b → (input x).getD i false = (input y).getD i false := by
  intro i hi
  by_cases hlt : i < 10
  · have hh : (decide ((⟨i,hlt⟩ : Fin 10) ∈ S)) = b := by
      simpa only [← hA] using hi
    unfold input
    rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
      List.getElem?_append_left (by simpa only [List.length_ofFn] using hlt),
      List.getElem?_append_left (by simpa only [List.length_ofFn] using hlt)]
    simpa only [List.getElem?_ofFn, hlt, dif_pos, Option.getD_some] using h ⟨i,hlt⟩ hh
  · by_cases he : i = 10
    · subst i
      have hh : decide ((0 : Fin 10) ∈ S) = b := by simpa only [← h0] using hi
      simp [input, List.getD_eq_getElem?_getD, List.getElem?_append_right, h 0 hh]
    · rw [List.getD_eq_default _ _ (by rw [input_len]; omega),
          List.getD_eq_default _ _ (by rw [input_len]; omega)]

def val (C : Circuit) (x : Fin 10 → Bool) (i : ℕ) := (C.wires (input x)).getD i false
lemma in_agree (C : Circuit) (S : Finset (Fin 10)) (A B : Finset ℕ)
    (hA : ∀ j : Fin 10, j.val ∈ A ↔ j ∈ S) (h0 : 10 ∈ A ↔ (0 : Fin 10) ∈ S)
    (hedge : ∀ (j : Fin C.size) i, i ∈ (C.gates.get j).inputs →
      (11+j.val ∈ A → i ∈ A) ∧ (11+j.val ∉ A → i ∈ A → i ∈ B))
    (x y : Fin 10 → Bool) (h : ∀ j ∈ S, x j = y j) :
    ∀ i ∈ A, val C x i = val C y i := by
  apply run_agree C.gates (input x) (input y) (fun i => i ∈ A) (fun _ => False)
  · simp [input_len]
  · intro i hi
    exact input_agree S A hA h0 true x y (fun j hj => h j (of_decide_eq_true hj)) i (by simp [hi])
  · intro j i hi hp
    exact Or.inl ((hedge j i hi).1 (by simpa [input_len] using hp))
  · simp

lemma out_agree (C : Circuit) (S : Finset (Fin 10)) (A B : Finset ℕ)
    (hA : ∀ j : Fin 10, j.val ∈ A ↔ j ∈ S) (h0 : 10 ∈ A ↔ (0 : Fin 10) ∈ S)
    (hedge : ∀ (j : Fin C.size) i, i ∈ (C.gates.get j).inputs →
      (11+j.val ∈ A → i ∈ A) ∧ (11+j.val ∉ A → i ∈ A → i ∈ B))
    (x y : Fin 10 → Bool) (h : ∀ j ∉ S, x j = y j)
    (hB : ∀ i ∈ A, i ∈ B → val C x i = val C y i) :
    ∀ i ∉ A, val C x i = val C y i := by
  apply run_agree C.gates (input x) (input y) (fun i => i ∉ A) (fun i => i ∈ A ∧ i ∈ B)
  · simp [input_len]
  · intro i hi
    exact input_agree S A hA h0 false x y (fun j hj => h j (of_decide_eq_false hj)) i (by simp [hi])
  · intro j i hi hp
    by_cases ha : i ∈ A
    · exact Or.inr ⟨ha,(hedge j i hi).2 (by simpa [input_len] using hp) ha⟩
    · exact Or.inl ha
  · intro i hi
    exact hB i hi.1 hi.2

def mask (s : ℕ) : Finset (Fin 10) := Finset.univ.filter fun i => s.testBit i.val
def probe (s t : ℕ) (k : Fin 11) (j : Fin 10) : Bool :=
  if s.testBit j.val then t.testBit j.val else decide (j.val = k.val)
def base (s t : ℕ) : Fin 10 → Bool := probe s t 10
def key (s t : ℕ) : ℕ :=
  (BitVec.ofBoolListLE (List.ofFn fun k : Fin 11 => graph (probe s t k))).toNat
def bound (k : ℕ) : ℕ := [1,2,4,6,9,12,9,9,5,3,2].getD k 0
lemma mask_mem (s : ℕ) (i : Fin 10) : i ∈ mask s ↔ s.testBit i.val = true := by simp [mask]
lemma mask_surj (S : Finset (Fin 10)) : ∃ s < 1024, mask s = S := by
  let b := BitVec.ofBoolListLE (List.ofFn fun j : Fin 10 => decide (j ∈ S))
  refine ⟨b.toNat, ?_, ?_⟩
  · simpa [b] using b.isLt
  · ext i
    rw [mask_mem]
    change b.getLsbD i.val = true ↔ _
    rw [BitVec.getLsbD_ofBoolListLE]
    simp only [List.getD_eq_getElem?_getD, List.getElem?_ofFn, i.isLt, dif_pos, Option.getD_some, decide_eq_true_eq]


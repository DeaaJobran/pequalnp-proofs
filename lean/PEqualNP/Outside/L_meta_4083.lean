lemma all_cert (s : ℕ) (hs : s < 1024) : cert s := by
  let j : Fin 32 := ⟨s % 32, Nat.mod_lt _ (by decide)⟩
  have h : s = s / 32 * 32 + j.val := by dsimp [j]; omega
  have hk : s / 32 < 32 := by omega
  generalize he : s / 32 = k at h hk
  interval_cases k <;> rw [h] <;> first
    | exact cert0 j
    | exact cert1 j
    | exact cert2 j
    | exact cert3 j
    | exact cert4 j

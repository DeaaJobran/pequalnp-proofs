lemma graph_eq : ∀ x : Fin 10 → Bool, graph x =
    decide (∃ i j : Fin 10, x i = true ∧ x j = true ∧
      (([50,69,138,276,521,385,770,548,104,208] : List ℕ).getD i.val 0).testBit j.val = true) := by
